# ════════════════════════════════════════════════════════════════════
#  VARIABLES DE ENTORNO — StarGo
#
#  Este archivo es SOLO una plantilla de referencia. No contiene valores
#  reales y es seguro subirlo al repo.
#
#  ¿Dónde se usan? Las leen las funciones serverless de Vercel (/api)
#  usando la SERVICE ROLE key de Supabase. El navegador NUNCA las ve.
#
#  Configúralas en Vercel: Project → Settings → Environment Variables.
#  En local (opcional): cópialo a `.env` y usa `vercel dev`.
#
#  ⚠ NUNCA subas `.env` a git (está en .gitignore) y NUNCA expongas la
#    service role key: con ella se puede administrar toda la base.
# ════════════════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────────────

# URL del proyecto de Supabase.
# Dónde encontrarla: Supabase → Project Settings → API → Project URL
# Formato: https://<referencia-del-proyecto>.supabase.co
SUPABASE_URL=

# Clave SECRETA de servicio (service_role).
# Dónde encontrarla: Supabase → Project Settings → API → service_role
# Solo se usa del lado del servidor (funciones /api). Si se filtra,
# cualquiera puede administrar la base: cámbiala de inmediato.
SUPABASE_SERVICE_ROLE_KEY=

# (La "anon key" ya no se usa: el navegador ya no se conecta a Supabase.)
